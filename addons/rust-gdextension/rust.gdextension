[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://target/debug/libtexel_splatting.so"
linux.release.x86_64 =   "res://target/release/libtexel_splatting.so"
windows.debug.x86_64 =   "res://target/debug/texel_splatting.dll"
windows.release.x86_64 = "res://target/release/texel_splatting.dll"
macos.debug =            "res://target/debug/libtexel_splatting.dylib"
macos.release =          "res://target/release/libtexel_splatting.dylib"
macos.debug.arm64 =      "res://target/debug/libtexel_splatting.dylib"
macos.release.arm64 =    "res://target/release/libtexel_splatting.dylib"

[icons]
Player = "icon.png"
